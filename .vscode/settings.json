{
    "kiro-codex-ide.codex.promptsPath": ".ralph/prompts",
    "kiro-codex-ide.codex.steeringPath": ".",
    "kiro-codex-ide.codex.specsPath": ".ralph",
    "ralphCodex.agentCount": 1,
    "ralphCodex.cliProvider": "copilot-byok",
    "ralphCodex.promptBudgetProfile": "codex",
    "ralphCodex.ralphIterationCap": 15,
    "ralphCodex.model": "gpt-5.4",
    "ralphCodex.agentId": "build",
    "ralphCodex.claudeMaxTurns": 125,
    "ralphCodex.scmStrategy": "commit-on-done",
    "ralphCodex.scmPrOnParentDone": false,
    "ralphCodex.enableModelTiering": true,
    "ralphCodex.modelTiering": {
        "enabled": true,
        "simple": {
            "model": "gpt-5.3-codex",
            "provider": "codex"
        },
        "medium": {
            "model": "gpt-5.4",
            "provider": "codex"
        },
        "complex": {
            "model": "gpt-5.5",
            "provider": "codex"
        }
    },
    "sarif-viewer.connectToGithubCodeScanning": "off",
    "ralphCodex.autonomyMode": "autonomous",
    "ralphCodex.copilotFoundry": {
        "baseUrlOverride": "https://me-me3mef6a-eastus2.cognitiveservices.azure.com/openai/deployments/gpt-5.4",
        "model": "gpt-5.4"
    }
}
