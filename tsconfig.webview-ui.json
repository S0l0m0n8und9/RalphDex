{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": [
    "src/webview-ui/**/*.ts",
    "src/webview-ui/**/*.tsx",
    "src/ui/uiTypes.ts",
    "src/config/settingsSurface.ts",
    "src/webview/dashboardSnapshot.ts",
    "src/webview/prdCreationWizardTypes.ts",
    "src/ralph/taskNormalization.ts",
    "src/ralph/types.ts"
  ]
}
